# ============================================================
# Evlurn — Variáveis de Ambiente
# Copie este arquivo para .env (nunca commitar o .env real)
# ============================================================

# ── OBRIGATÓRIAS EM PRODUÇÃO ─────────────────────────────────

# Senha do administrador padrão.
# DEVE ser definida antes do primeiro deploy.
# Mínimo: 12 caracteres, mix de letras, números e símbolos.
ADMIN_PASSWORD=

# Caminho persistente do banco de dados (Railway Volume).
# No Railway: defina como /data
# Em desenvolvimento: deixar vazio (usa ./data/database.sqlite)
DATABASE_DIR=

# ── OPCIONAIS ────────────────────────────────────────────────

# Ambiente de execução.
# Em produção: production
# Em desenvolvimento: deixar vazio
NODE_ENV=

# Porta do servidor (Railway define automaticamente).
# Só definir manualmente em desenvolvimento se necessário.
# PORT=3000
